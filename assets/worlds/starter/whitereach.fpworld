  "locations": [
    {
      "formatVersion": 1,
      "id": "starter-whitereach-hearthford",
      "name": "Hearthford",
      "description": "A valley town tucked into a fold of the hills, where warm ground keeps the snow off the fields while the ridges above stay white. Steam drifts from vents beside the lanes, the market stays open late, and children play outside in shirtsleeves while frost glitters on the peaks.",
      "lorebook": {
        "entries": []
      },
      "climate_enabled": true,
      "biome": {
        "id": "temperate",
        "displayName": "Temperate"
      },
      "meta": {
        "sourceId": "starter-whitereach-hearthford"
      }
    },
    {
      "formatVersion": 1,
      "id": "starter-whitereach-thawwater-springs",
      "name": "Thawwater Springs",
      "description": "Terraced hot-spring pools climb a hillside under a great glass roof, beaded with condensation and ringed with potted lemon trees. Bathers lounge in the steam, attendants carry towels and iced tea between the tiers, and through the glass the snowfields shine blue at dusk.",
      "lorebook": {
        "entries": []
      },
      "climate_enabled": true,
      "biome": {
        "id": "mediterranean",
        "displayName": "Mediterranean"
      },
      "meta": {
        "sourceId": "starter-whitereach-thawwater-springs"
      }
    },
    {
      "formatVersion": 1,
      "id": "starter-whitereach-emberlight",
      "name": "Emberlight",
      "description": "A mining town built over its own warm vents: brick chimneys, copper pipes and lit workshop windows. Shift whistles mark the day and the streets smell of coal smoke and fresh bread. Winters still bring real snow, but the town gets proper summers too, loud with thunderstorms, which is more than the ice outside can say.",
      "lorebook": {
        "entries": []
      },
      "climate_enabled": true,
      "biome": {
        "id": "continental",
        "displayName": "Continental"
      },
      "meta": {
        "sourceId": "starter-whitereach-emberlight"
      }
    }
  ],
  "default_place_id": "starter-whitereach-hearthford",
