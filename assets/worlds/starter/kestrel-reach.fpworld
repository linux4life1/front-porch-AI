    "entries": []
  },
  "climate_enabled": true,
  "biome": {
    "id": "starter_airless",
    "displayName": "Airless moon",
    "description": "No air and no rain: a black sky, hard sunlight and the odd drift of dust.",
    "feel": "Outside is silent and deadly cold; nobody goes out without a suit. Weather means dust kicked up by landers and crawlers, and the long swing from light to dark.",
