{
  "formatVersion": 1,
  "id": "starter-whitereach",
  "name": "The Whitereach",
  "description": "A wide white country of frozen lakes, low hills and long wind, where snow lies on the ground most of the year and fog rolls in off the ice without warning. Sled runners hiss along marked trails between the warm valleys, and travellers learn to read the sky before they leave a door. Lamps burn in the windows all day through the dark months.",
  "lorebook": {
    "entries": []
  },
  "climate_enabled": true,
  "biome": {
    "id": "starter_tundra",
    "displayName": "Tundra",
    "description": "Frozen most of the year: snow, fog and grey skies, then a short cool thaw.",
    "feel": "Breath fogs, boots crunch and every trip outside is planned around the cold. The brief thaw brings meltwater, mud and long pale evenings, never real warmth.",
