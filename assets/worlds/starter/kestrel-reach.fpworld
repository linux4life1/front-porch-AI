      }
    },
    {
      "formatVersion": 1,
      "id": "starter-kestrel-reach-the-ring",
      "name": "The Ring",
      "description": "An orbital habitat shaped like a great wheel, spun so its people walk with a familiar weight. Its inner surface curves up into the sky in both directions: parks, canals and terraced neighbourhoods under a long sunlit strip that dims each evening. It feels like a warm coastal town, if you ignore the houses hanging overhead.",
      "cover": "data:image/jpeg;base64,",
      "lorebook": {
        "entries": []
      },
      "climate_enabled": true,
