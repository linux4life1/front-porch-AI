function(fpai_select_onnx_runtime output)
  set(runtime)
  foreach(library IN LISTS ARGN)
    get_filename_component(name "${library}" NAME)
    string(TOLOWER "${name}" name)
    if(name STREQUAL "onnxruntime.dll")
      if(runtime)
        message(FATAL_ERROR "Sherpa declares more than one ONNX runtime")
      endif()
      set(runtime "${library}")
    endif()
  endforeach()
  if(NOT runtime OR NOT EXISTS "${runtime}")
    message(FATAL_ERROR "Sherpa's matching Windows ONNX runtime is missing")
  endif()
  get_filename_component(directory "${runtime}" DIRECTORY)
  file(GLOB providers CONFIGURE_DEPENDS "${directory}/onnxruntime_providers_*.dll")
  set(${output} "${runtime};${providers}" PARENT_SCOPE)
endfunction()

function(fpai_remove_onnx_runtime output)
  set(filtered)
  foreach(library IN LISTS ARGN)
    get_filename_component(name "${library}" NAME)
    string(TOLOWER "${name}" name)
    if(NOT name MATCHES "^onnxruntime(_providers_.+)?[.]dll$")
      list(APPEND filtered "${library}")
    endif()
  endforeach()
  set(${output} "${filtered}" PARENT_SCOPE)
endfunction()
