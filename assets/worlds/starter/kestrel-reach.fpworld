  "locations": [
    {
      "formatVersion": 1,
      "id": "starter-kestrel-reach-dome-town-meridian",
      "name": "Dome Town Meridian",
      "description": "A farming town under a vast clear dome, with terraced fields, orchards and a small lake the colonists swear is the bluest water on the moon. People bounce when they walk, children clear fences for fun, and the dome rolls out rain on a schedule everyone grumbles about. Beyond the glass the grey plain runs to a black horizon.",
      "cover": "data:image/jpeg;base64,",
