      "meta": {
        "sourceId": "starter-kestrel-reach-the-ring"
      }
    },
    {
      "formatVersion": 1,
      "id": "starter-kestrel-reach-outpost-nine",
      "name": "Outpost Nine",
      "description": "A cramped research and mining outpost dug into a crater wall, reached by crawler across the open plain. Nobody steps outside without a pressure suit, and every door to the surface is an airlock with a cycle light and a checklist. Inside it smells of machine oil and recycled air, and the crew keep a card game running in the galley.",
      "cover": "data:image/jpeg;base64,",
      "lorebook": {
